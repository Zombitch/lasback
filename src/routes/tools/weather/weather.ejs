<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cocon sous l'orage</title>
  <style>
    :root {
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #05070d;
      font-family: Georgia, 'Times New Roman', serif;
    }

    #scene {
      position: relative;
      width: 100vw;
      height: 100vh;
    }

    /* Stormy sky outside the window */
    #sky {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, #2a3550 0%, #131a2c 45%, #05070d 100%);
    }

    #rain-canvas {
      position: absolute;
      inset: 0;
    }

    #lightning-flash {
      position: absolute;
      inset: 0;
      background: #eef3ff;
      opacity: 0;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    /* The cozy cocoon: a warm vignette framing the room, contrasted with the
       cold storm outside the "window" */
    #cocoon-vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse at 50% 100%, rgba(255, 176, 92, 0.35) 0%, rgba(255, 176, 92, 0) 55%),
        radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0) 40%, rgba(5,7,13,0.85) 100%);
    }

    #caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6vh;
      text-align: center;
      color: #ffe6c2;
      text-shadow: 0 2px 12px rgba(0,0,0,0.8);
      font-size: 1.15rem;
      letter-spacing: 0.04em;
      padding: 0 1.5rem;
      pointer-events: none;
    }

    #start-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      background: rgba(5, 7, 13, 0.88);
      color: #ffe6c2;
      text-align: center;
      padding: 2rem;
    }

    #start-overlay h1 {
      font-weight: normal;
      font-size: 1.6rem;
      margin: 0;
      max-width: 32rem;
    }

    #start-button {
      font-family: inherit;
      font-size: 1.05rem;
      padding: 0.75rem 1.75rem;
      border-radius: 999px;
      border: 1px solid #ffb05c;
      background: rgba(255, 176, 92, 0.12);
      color: #ffe6c2;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    #start-button:hover {
      background: rgba(255, 176, 92, 0.28);
    }

    #mute-button {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      z-index: 5;
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 230, 194, 0.4);
      background: rgba(5, 7, 13, 0.4);
      color: #ffe6c2;
      cursor: pointer;
      display: none;
    }
  </style>
</head>
<body>
  <div id="scene">
    <div id="sky"></div>
    <canvas id="rain-canvas"></canvas>
    <div id="lightning-flash"></div>
    <div id="cocoon-vignette"></div>
    <div id="caption">Restons dans notre cocon, pendant que le temps se déchaîne dehors.</div>
    <button id="mute-button" type="button" aria-pressed="false">🔊 Couper le son</button>

    <div id="start-overlay">
      <h1>Un abri douillet, une tempête au dehors.</h1>
      <button id="start-button" type="button">Entrer dans le cocon</button>
    </div>
  </div>

  <script>
    (function () {
      var canvas = document.getElementById('rain-canvas');
      var ctx = canvas.getContext('2d');
      var flashEl = document.getElementById('lightning-flash');
      var startOverlay = document.getElementById('start-overlay');
      var startButton = document.getElementById('start-button');
      var muteButton = document.getElementById('mute-button');

      var width = 0;
      var height = 0;
      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // ---- Raindrop visual simulation ----
      var DROP_COUNT = 220;
      var drops = [];
      function makeDrop() {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          len: 10 + Math.random() * 18,
          speed: 420 + Math.random() * 380,
          sway: (Math.random() - 0.5) * 20,
        };
      }
      for (var i = 0; i < DROP_COUNT; i++) drops.push(makeDrop());

      // ---- Audio (Web Audio API) ----
      var AudioCtx = window.AudioContext || window.webkitAudioContext;
      var audioCtx = null;
      var thunderBuffer = null;
      var masterGain = null;
      var rainGainNode = null;
      var muted = false;

      function loadSound(url) {
        return fetch(url)
          .then(function (r) { return r.arrayBuffer(); })
          .then(function (buf) { return audioCtx.decodeAudioData(buf); });
      }

      function playThunderSound() {
        if (!audioCtx || !thunderBuffer || muted) return;
        var source = audioCtx.createBufferSource();
        source.buffer = thunderBuffer;
        source.playbackRate.value = 0.95 + Math.random() * 0.1;

        var gainNode = audioCtx.createGain();
        gainNode.gain.value = 0.6 + Math.random() * 0.3;

        var node = gainNode;
        if (audioCtx.createStereoPanner) {
          var panner = audioCtx.createStereoPanner();
          panner.pan.value = (Math.random() - 0.5) * 0.6;
          gainNode.connect(panner);
          node = panner;
        }

        source.connect(gainNode);
        node.connect(masterGain);
        source.start();
      }

      function startRainLoop(buffer) {
        var source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;

        rainGainNode = audioCtx.createGain();
        rainGainNode.gain.value = 0;
        source.connect(rainGainNode).connect(masterGain);
        source.start();

        // Fade the continuous rain loop in rather than snapping it on.
        var target = muted ? 0 : 0.7;
        rainGainNode.gain.linearRampToValueAtTime(target, audioCtx.currentTime + 2.5);
      }

      // ---- Lightning bolt geometry ----
      // A real bolt is a jagged fractal path, not a flat flash: build one
      // with classic midpoint displacement (repeatedly bend each segment's
      // midpoint sideways by a shrinking random amount), plus a couple of
      // shorter forking branches off the main stem.
      function midpointDisplace(p0, p1, displace, depth, out) {
        if (depth <= 0) {
          out.push(p1);
          return;
        }
        var mx = (p0[0] + p1[0]) / 2;
        var my = (p0[1] + p1[1]) / 2;
        var dx = p1[0] - p0[0];
        var dy = p1[1] - p0[1];
        var len = Math.sqrt(dx * dx + dy * dy) || 1;
        var nx = -dy / len;
        var ny = dx / len;
        var offset = (Math.random() * 2 - 1) * displace;
        var mid = [mx + nx * offset, my + ny * offset];
        midpointDisplace(p0, mid, displace * 0.55, depth - 1, out);
        midpointDisplace(mid, p1, displace * 0.55, depth - 1, out);
      }

      function generateBoltPath(x0, y0, x1, y1, displace, depth) {
        var points = [[x0, y0]];
        midpointDisplace([x0, y0], [x1, y1], displace, depth, points);
        return points;
      }

      function generateBranches(mainPoints) {
        var branches = [];
        var count = 1 + Math.floor(Math.random() * 3);
        for (var i = 0; i < count; i++) {
          var idx = Math.floor(mainPoints.length * (0.2 + Math.random() * 0.5));
          var start = mainPoints[idx];
          var length = 60 + Math.random() * 140;
          var angle = Math.PI / 2 + (Math.random() - 0.5) * 1.2; // mostly downward, spread sideways
          var end = [start[0] + Math.cos(angle) * length, start[1] + Math.sin(angle) * length];
          branches.push(generateBoltPath(start[0], start[1], end[0], end[1], length * 0.25, 3));
        }
        return branches;
      }

      function drawBoltPath(points, alpha, lineWidth, glow) {
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = '#eaf2ff';
        ctx.lineWidth = lineWidth;
        ctx.shadowColor = '#bcd7ff';
        ctx.shadowBlur = glow;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(points[0][0], points[0][1]);
        for (var i = 1; i < points.length; i++) ctx.lineTo(points[i][0], points[i][1]);
        ctx.stroke();
        ctx.restore();
      }

      function drawBolt(bolt, alpha) {
        drawBoltPath(bolt.main, alpha, 3, 25);
        for (var i = 0; i < bolt.branches.length; i++) {
          drawBoltPath(bolt.branches[i], alpha * 0.7, 1.6, 15);
        }
      }

      // Real lightning flickers — a bright instant strike, a brief dark gap,
      // a dimmer second flash, then the sky afterglow fades out. Returns
      // null once the sequence is over.
      function getLightningState(elapsedMs) {
        if (elapsedMs < 40) return { boltAlpha: 1, skyAlpha: 0.6 };
        if (elapsedMs < 90) return { boltAlpha: 0, skyAlpha: 0.1 };
        if (elapsedMs < 130) return { boltAlpha: 0.75, skyAlpha: 0.35 };
        if (elapsedMs < 300) return { boltAlpha: 0, skyAlpha: 0.16 * (1 - (elapsedMs - 130) / 170) };
        return null;
      }

      var activeBolt = null;
      var lightningTimeoutId = null;
      var lastLightningTime = -Infinity;

      function triggerLightning() {
        lastLightningTime = performance.now();

        var x0 = width * 0.15 + Math.random() * width * 0.7;
        var y0 = 0;
        var x1 = x0 + (Math.random() - 0.5) * width * 0.3;
        var y1 = height * (0.35 + Math.random() * 0.4);
        var mainPoints = generateBoltPath(x0, y0, x1, y1, Math.max(20, (y1 - y0) * 0.12), 6);

        activeBolt = {
          main: mainPoints,
          branches: generateBranches(mainPoints),
          startTime: lastLightningTime,
        };

        // Thunder lags behind the flash, like distant lightning.
        var thunderDelay = 250 + Math.random() * 1300;
        setTimeout(playThunderSound, thunderDelay);

        clearTimeout(lightningTimeoutId);
        scheduleNextLightning();
      }

      function scheduleNextLightning() {
        var next = 13000 + Math.random() * 60000;
        lightningTimeoutId = setTimeout(triggerLightning, next);
      }

      // ---- Animation loop ----
      var lastTime = null;
      function tick(timestamp) {
        if (lastTime === null) lastTime = timestamp;
        var dt = Math.min((timestamp - lastTime) / 1000, 0.05);
        lastTime = timestamp;

        ctx.clearRect(0, 0, width, height);
        ctx.strokeStyle = 'rgba(200, 220, 255, 0.5)';
        ctx.lineWidth = 1.4;

        for (var i = 0; i < drops.length; i++) {
          var d = drops[i];
          d.y += d.speed * dt;
          d.x += d.sway * dt;

          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(d.x - d.sway * 0.05, d.y - d.len);
          ctx.stroke();

          if (d.y > height) {
            d.y = -d.len - Math.random() * 40;
            d.x = Math.random() * width;
          }
        }

        if (activeBolt) {
          var state = getLightningState(timestamp - activeBolt.startTime);
          if (!state) {
            activeBolt = null;
            flashEl.style.opacity = 0;
          } else {
            flashEl.style.opacity = state.skyAlpha;
            if (state.boltAlpha > 0) drawBolt(activeBolt, state.boltAlpha);
          }
        }

        requestAnimationFrame(tick);
      }

      function startExperience() {
        startOverlay.style.display = 'none';
        muteButton.style.display = 'inline-block';

        audioCtx = new AudioCtx();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = 1;
        masterGain.connect(audioCtx.destination);

        loadSound('/tools/weather/sounds/thunder.wav?v=<%= thunderVersion %>').then(function (buffer) {
          thunderBuffer = buffer;
        });

        loadSound('/tools/weather/sounds/rain.wav?v=<%= rainVersion %>').then(startRainLoop);

        scheduleNextLightning();
        requestAnimationFrame(tick);
      }

      startButton.addEventListener('click', function () {
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (!audioCtx) startExperience();
      });

      muteButton.addEventListener('click', function () {
        muted = !muted;
        if (masterGain) masterGain.gain.value = muted ? 0 : 1;
        muteButton.textContent = muted ? '🔇 Activer le son' : '🔊 Couper le son';
        muteButton.setAttribute('aria-pressed', String(muted));
      });

      // Clicking the storm itself calls down a strike. Ignored on buttons
      // (start/mute) and rate-limited so spam-clicking can't machine-gun
      // flashes and overlapping thunder.
      document.addEventListener('click', function (e) {
        if (!audioCtx) return;
        if (e.target.closest && e.target.closest('button')) return;
        if (performance.now() - lastLightningTime < 700) return;
        triggerLightning();
      });
    })();
  </script>
</body>
</html>
