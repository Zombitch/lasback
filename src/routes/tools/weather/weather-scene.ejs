<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= ambiance.name %></title>
  <style>
    :root {
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #05070d;
      font-family: Georgia, 'Times New Roman', serif;
      touch-action: none;
    }

    #scene {
      position: relative;
      width: 100vw;
      height: 100vh;
    }

    /* Sky outside the window — the one thing that's actually per-ambiance
       besides the particles; the warm interior stays the same for all. */
    #sky {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, <%= ambiance.skyColors[0] %> 0%, <%= ambiance.skyColors[1] %> 45%, <%= ambiance.skyColors[2] %> 100%);
    }

    /* Two optional image layers, purely decorative — never intercept
       pointer events, the click/drag gestures work through them exactly
       as if they weren't there. Empty (no backgroundImage set) means
       fully transparent, so with neither set the plain sky gradient shows
       through exactly as before this existed. #background-2 sits behind
       the canvas (the weather happens in front of it); #background-1
       sits in front of it (the weather happens behind it — a dashboard
       silhouette, a window frame…). Either can be set without the other. */
    .bg-layer {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      pointer-events: none;
    }

    #weather-canvas {
      position: absolute;
      inset: 0;
    }

    #lightning-flash {
      position: absolute;
      inset: 0;
      background: #eef3ff;
      opacity: 0;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    /* The cozy cocoon: a warm vignette framing the room, contrasted with the
       cold storm outside the "window" */
    #cocoon-vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse at 50% 100%, rgba(255, 176, 92, 0.35) 0%, rgba(255, 176, 92, 0) 55%),
        radial-gradient(ellipse at 50% 50%, rgba(0,0,0,0) 40%, rgba(5,7,13,0.85) 100%);
    }

    /* Storm-intensity feedback — only shown while actively dragging */
    #intensity-gauge {
      position: absolute;
      top: 50%;
      right: 1.4rem;
      transform: translateY(-50%);
      width: 6px;
      height: 140px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 230, 194, 0.25);
      overflow: hidden;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: 4;
    }
    #intensity-gauge.visible {
      opacity: 0.9;
    }
    #intensity-gauge-fill {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 50%;
      background: linear-gradient(180deg, #ffb05c, #eaf2ff);
    }

    #caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 6vh;
      text-align: center;
      color: #ffe6c2;
      text-shadow: 0 2px 12px rgba(0,0,0,0.8);
      font-size: 1.15rem;
      letter-spacing: 0.04em;
      padding: 0 1.5rem;
      pointer-events: none;
    }

    #start-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      background: rgba(5, 7, 13, 0.88);
      color: #ffe6c2;
      text-align: center;
      padding: 2rem;
    }

    #start-overlay h1 {
      font-weight: normal;
      font-size: 1.6rem;
      margin: 0;
      max-width: 32rem;
    }

    #start-overlay p {
      font-size: 0.95rem;
      opacity: 0.75;
      margin: 0;
      max-width: 28rem;
    }

    #start-button {
      font-family: inherit;
      font-size: 1.05rem;
      padding: 0.75rem 1.75rem;
      border-radius: 999px;
      border: 1px solid #ffb05c;
      background: rgba(255, 176, 92, 0.12);
      color: #ffe6c2;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    #start-button:hover {
      background: rgba(255, 176, 92, 0.28);
    }

    #controls {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    #change-ambiance {
      font-family: inherit;
      font-size: 0.8rem;
      color: #ffe6c2;
      opacity: 0.55;
      text-decoration: none;
      padding: 0.3rem 0.4rem;
      transition: opacity 0.2s ease;
    }
    #change-ambiance:hover,
    #change-ambiance:focus-visible {
      opacity: 0.9;
    }

    #timer-select {
      font-family: inherit;
      font-size: 0.85rem;
      padding: 0.4rem 0.7rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 230, 194, 0.4);
      background: rgba(5, 7, 13, 0.4);
      color: #ffe6c2;
      cursor: pointer;
      display: none;
    }
    #timer-select option {
      background: #05070d;
      color: #ffe6c2;
    }

    #timer-remaining {
      font-family: inherit;
      font-size: 0.8rem;
      color: #ffe6c2;
      opacity: 0.75;
      white-space: nowrap;
      display: none;
    }

    #eyes-button {
      font-family: inherit;
      font-size: 0.9rem;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 230, 194, 0.4);
      background: rgba(5, 7, 13, 0.4);
      color: #ffe6c2;
      cursor: pointer;
      display: none;
    }

    /* Opaque, sits above everything (including #controls) so nothing is
       reachable except tapping to exit. */
    #closed-eyes-overlay {
      position: absolute;
      inset: 0;
      z-index: 30;
      background: #05070d;
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    #closed-eyes-overlay.active {
      display: flex;
    }
    #closed-eyes-hint {
      color: #ffe6c2;
      opacity: 0.5;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      text-align: center;
      padding: 0 2rem;
      transition: opacity 3s ease 1.5s;
      pointer-events: none;
    }
    #closed-eyes-hint.faded {
      opacity: 0;
    }
  </style>
</head>
<body>
  <div id="scene">
    <div id="sky"></div>
    <div
      id="background-2"
      class="bg-layer"
      <% if (ambiance.images.background2) { %>
      style="background-image: linear-gradient(<%= ambiance.skyColors[1] %>66, <%= ambiance.skyColors[1] %>66), url('/tools/weather/images/<%= ambiance.id %>/background2?v=<%= imageVersions.background2 %>');"
      <% } %>
    ></div>
    <canvas id="weather-canvas"></canvas>
    <div
      id="background-1"
      class="bg-layer"
      <% if (ambiance.images.background1) { %>
      style="background-image: linear-gradient(<%= ambiance.skyColors[1] %>66, <%= ambiance.skyColors[1] %>66), url('/tools/weather/images/<%= ambiance.id %>/background1?v=<%= imageVersions.background1 %>');"
      <% } %>
    ></div>
    <div id="lightning-flash"></div>
    <div id="cocoon-vignette"></div>
    <div id="intensity-gauge"><div id="intensity-gauge-fill"></div></div>
    <div id="caption"><%= ambiance.caption %></div>

    <div id="controls">
      <a id="change-ambiance" href="/tools/weather">🔄 Ambiances</a>
      <span id="timer-remaining" aria-live="polite"></span>
      <select id="timer-select" aria-label="Minuterie">
        <option value="0">Pas de minuterie</option>
        <option value="1">1 min</option>
        <option value="15">15 min</option>
        <option value="30">30 min</option>
        <option value="45">45 min</option>
        <option value="60">60 min</option>
      </select>
      <button id="eyes-button" type="button">🌙 Fermer les yeux</button>
    </div>

    <div id="start-overlay">
      <h1><%= ambiance.name %></h1>
      <p><%= ambiance.cardText %></p>
      <button id="start-button" type="button">Entrer dans le cocon</button>
    </div>

    <div id="closed-eyes-overlay">
      <div id="closed-eyes-hint">Touchez l'écran pour rouvrir les yeux</div>
    </div>
  </div>

  <script>
    (function () {
      var PARTICLE_TYPE = '<%= ambiance.particleType %>';
      var HAS_LIGHTNING = <%= ambiance.hasLightning ? 'true' : 'false' %>;
      var LOOP_URL = <% if (ambiance.sounds.loop) { %>'/tools/weather/sounds/<%= ambiance.id %>/loop.wav?v=<%= soundVersions.loop %>'<% } else { %>null<% } %>;
      var ACCENT_URL = <% if (ambiance.sounds.accent) { %>'/tools/weather/sounds/<%= ambiance.id %>/accent.wav?v=<%= soundVersions.accent %>'<% } else { %>null<% } %>;

      var canvas = document.getElementById('weather-canvas');
      var ctx = canvas.getContext('2d');
      var flashEl = document.getElementById('lightning-flash');
      var startOverlay = document.getElementById('start-overlay');
      var startButton = document.getElementById('start-button');
      var timerSelect = document.getElementById('timer-select');
      var timerRemaining = document.getElementById('timer-remaining');
      var intensityGauge = document.getElementById('intensity-gauge');
      var intensityGaugeFill = document.getElementById('intensity-gauge-fill');
      var eyesButton = document.getElementById('eyes-button');
      var closedEyesOverlay = document.getElementById('closed-eyes-overlay');
      var closedEyesHint = document.getElementById('closed-eyes-hint');

      var width = 0;
      var height = 0;
      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // ---- Rain particle system (falling streaks + puddle ripples) ----
      var DROP_COUNT = 220;
      var drops = [];
      function makeDrop() {
        var len = 10 + Math.random() * 18;
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          len: len,
          speed: 420 + Math.random() * 380,
          sway: (Math.random() - 0.5) * 20,
          // 0-1, derived from size — used to vary both how the drop is
          // drawn (thicker/brighter) and how loud/low its splash sounds.
          weight: (len - 10) / 18,
        };
      }

      var ripples = [];
      function spawnRipple(x, weight) {
        ripples.push({
          x: x,
          y: height - Math.random() * 14,
          radius: 1,
          maxRadius: 14 + weight * 22,
          alpha: 0.5 + weight * 0.2,
        });
        if (ripples.length > 150) ripples.shift();
      }

      function updateAndDrawRipples(dt) {
        for (var r = ripples.length - 1; r >= 0; r--) {
          var rp = ripples[r];
          rp.radius += 60 * dt;
          rp.alpha -= dt * 1.1;
          if (rp.alpha <= 0 || rp.radius >= rp.maxRadius) {
            ripples.splice(r, 1);
            continue;
          }
          ctx.beginPath();
          ctx.strokeStyle = 'rgba(210, 230, 255, ' + Math.max(0, rp.alpha) + ')';
          ctx.lineWidth = 1;
          ctx.ellipse(rp.x, rp.y, rp.radius, rp.radius * 0.35, 0, 0, Math.PI * 2);
          ctx.stroke();
        }
      }

      function updateAndDrawRain(dt) {
        updateAndDrawRipples(dt);

        var speedFactor = lerp3(0.4, 1, 2.5, intensity);
        var windFactor = lerp3(0.15, 1, 4.5, intensity);

        for (var i = 0; i < drops.length; i++) {
          var d = drops[i];
          d.y += d.speed * speedFactor * dt;
          d.x += d.sway * windFactor * dt;

          var tailX = d.x - d.sway * windFactor * 0.05;
          var tailY = d.y - d.len;

          // Soft halo pass, then a brighter core, then a tiny bright head —
          // reads as a glossy droplet streak instead of a flat gray line.
          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(tailX, tailY);
          ctx.strokeStyle = 'rgba(190, 215, 255, ' + (0.1 + d.weight * 0.08) + ')';
          ctx.lineWidth = 3 + d.weight * 3;
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(d.x, d.y);
          ctx.lineTo(tailX, tailY);
          ctx.strokeStyle = 'rgba(228, 242, 255, ' + (0.55 + d.weight * 0.3) + ')';
          ctx.lineWidth = 1 + d.weight;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(d.x, d.y, 1 + d.weight, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(235, 247, 255, 0.55)';
          ctx.fill();

          if (d.y > height) {
            if (Math.random() < 0.35) spawnRipple(d.x, d.weight);
            d.y = -d.len - Math.random() * 40;
            d.x = Math.random() * width;
          }
        }
      }

      // ---- Snow particle system (soft drifting flakes, no ripples) ----
      var SNOW_COUNT = 160;
      var snowflakes = [];
      function makeSnowflake() {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r: 1.5 + Math.random() * 2.5,
          speed: 30 + Math.random() * 45,
          swayPhase: Math.random() * Math.PI * 2,
          swaySpeed: 0.5 + Math.random() * 1,
          swayAmount: 10 + Math.random() * 22,
        };
      }

      function updateAndDrawSnow(dt) {
        var speedFactor = lerp3(0.5, 1, 2, intensity);
        for (var i = 0; i < snowflakes.length; i++) {
          var f = snowflakes[i];
          f.y += f.speed * speedFactor * dt;
          f.swayPhase += f.swaySpeed * dt;
          var x = f.x + Math.sin(f.swayPhase) * f.swayAmount;

          ctx.beginPath();
          ctx.arc(x, f.y, f.r, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
          ctx.fill();

          if (f.y - f.r > height) {
            f.y = -f.r;
            f.x = Math.random() * width;
          }
        }
      }

      // ---- Wind particle system (blowing dust/sand, no falling) ----
      var WIND_COUNT = 140;
      var windParticles = [];
      function makeWindParticle() {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          len: 15 + Math.random() * 35,
          speed: 260 + Math.random() * 260,
          driftY: (Math.random() - 0.5) * 30,
        };
      }

      function updateAndDrawWind(dt) {
        var speedFactor = lerp3(0.5, 1, 2.2, intensity);
        for (var i = 0; i < windParticles.length; i++) {
          var p = windParticles[i];
          p.x += p.speed * speedFactor * dt;
          p.y += p.driftY * speedFactor * dt * 0.2;

          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(p.x - p.len, p.y - p.len * 0.15);
          ctx.strokeStyle = 'rgba(210, 198, 172, 0.35)';
          ctx.lineWidth = 1.2;
          ctx.stroke();

          if (p.x - p.len > width) {
            p.x = -p.len;
            p.y = Math.random() * height;
          }
        }
      }

      if (PARTICLE_TYPE === 'rain') {
        for (var i = 0; i < DROP_COUNT; i++) drops.push(makeDrop());
      } else if (PARTICLE_TYPE === 'snow') {
        for (var si = 0; si < SNOW_COUNT; si++) snowflakes.push(makeSnowflake());
      } else if (PARTICLE_TYPE === 'wind') {
        for (var wi = 0; wi < WIND_COUNT; wi++) windParticles.push(makeWindParticle());
      }

      // ---- Window condensation — small beads on the glass in front of
      // everything else, mostly still, occasionally sliding a short
      // distance. Shared across every ambiance: whatever's happening
      // outside, it's still the same window being looked through. ----
      var CONDENSATION_COUNT = 18;
      var condensationDrops = [];
      function makeCondensationDrop() {
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          r: 4 + Math.random() * 7,
          sliding: false,
          slideProgress: 0,
          slideDistance: 0,
        };
      }
      for (var ci = 0; ci < CONDENSATION_COUNT; ci++) condensationDrops.push(makeCondensationDrop());

      // ---- Audio (Web Audio API) ----
      var AudioCtx = window.AudioContext || window.webkitAudioContext;
      var audioCtx = null;
      var accentBuffer = null;
      var masterGain = null;
      var loopGainNode = null;
      var loopSourceNode = null;
      var muted = false;

      function loadSound(url) {
        return fetch(url)
          .then(function (r) { return r.arrayBuffer(); })
          .then(function (buf) { return audioCtx.decodeAudioData(buf); });
      }

      // distanceFactor: 0 = right overhead, 1 = far away. Farther sounds
      // quieter and duller (air absorbs high frequencies over distance) —
      // the same cue game audio uses to sell distance. Only meaningful for
      // ambiances with lightning; nothing else calls this.
      function playAccentSound(distanceFactor, pan) {
        if (!audioCtx || !accentBuffer || muted) return;

        var source = audioCtx.createBufferSource();
        source.buffer = accentBuffer;
        source.playbackRate.value = 0.95 + Math.random() * 0.1;

        var filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 9000 - distanceFactor * 7000;

        var gainNode = audioCtx.createGain();
        gainNode.gain.value = (0.85 - distanceFactor * 0.5) * (0.85 + Math.random() * 0.3);

        source.connect(filter);
        var node = filter;

        if (audioCtx.createStereoPanner) {
          var panner = audioCtx.createStereoPanner();
          panner.pan.value = pan * 0.7;
          node.connect(panner);
          node = panner;
        }

        node.connect(gainNode);
        gainNode.connect(masterGain);
        source.start();
      }

      function startLoop(buffer) {
        var source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;

        loopGainNode = audioCtx.createGain();
        loopGainNode.gain.value = 0;
        source.connect(loopGainNode).connect(masterGain);
        source.start();

        loopSourceNode = source;

        // Fade the continuous loop in from silence over the first few
        // seconds rather than snapping it on, then let applyIntensity own
        // the level from here on.
        applyIntensity(2.5);
      }

      // Speeds up (rate > 1) or slows down (rate < 1) the ambiance loop.
      // AudioBufferSourceNode.playbackRate is a live AudioParam, so this
      // takes effect immediately on the already-playing loop with no need
      // to restart it — pass rampSeconds for a smooth glide instead of an
      // instant jump.
      //
      // Note: this resamples rather than time-stretches, so pitch shifts
      // with it too (slower = deeper, faster = higher) — that's inherent
      // to this technique, not a bug.
      function setLoopPlaybackRate(rate, rampSeconds) {
        if (!loopSourceNode) return;
        if (rampSeconds) {
          loopSourceNode.playbackRate.linearRampToValueAtTime(rate, audioCtx.currentTime + rampSeconds);
        } else {
          loopSourceNode.playbackRate.value = rate;
        }
      }

      // ---- Storm intensity — slide up for wilder, slide down for calmer ----
      // 0.5 is the resting default and is deliberately chosen so every
      // value below matches what was already tuned before this control
      // existed — nothing changes until someone actually drags. Applies to
      // every ambiance (fall/blow speed, wind, loop volume/pitch);
      // deliberately does NOT touch lightning frequency, which is tuned
      // independently.
      var intensity = 0.5;

      function lerp3(calmVal, restVal, wildVal, t) {
        if (t <= 0.5) return calmVal + (restVal - calmVal) * (t / 0.5);
        return restVal + (wildVal - restVal) * ((t - 0.5) / 0.5);
      }

      function applyIntensity(rampSeconds) {
        var ramp = rampSeconds || 0.15;
        if (loopGainNode && audioCtx) {
          loopGainNode.gain.linearRampToValueAtTime(lerp3(0.25, 0.7, 1, intensity), audioCtx.currentTime + ramp);
        }
        // Pitch shift is capped more conservatively than the other knobs —
        // playbackRate resamples rather than time-stretches, so pushing it
        // much past this starts sounding chipmunked/cartoonish rather than
        // "more intense".
        setLoopPlaybackRate(lerp3(0.75, 1, 1.4, intensity), ramp);
        intensityGaugeFill.style.height = (intensity * 100) + '%';
      }

      function setIntensity(value) {
        intensity = Math.max(0, Math.min(1, value));
        applyIntensity();
      }

      // ---- Lightning bolt geometry (only used when HAS_LIGHTNING) ----
      // A real bolt is a jagged fractal path, not a flat flash: build one
      // with classic midpoint displacement (repeatedly bend each segment's
      // midpoint sideways by a shrinking random amount), plus a couple of
      // shorter forking branches off the main stem.
      function midpointDisplace(p0, p1, displace, depth, out) {
        if (depth <= 0) {
          out.push(p1);
          return;
        }
        var mx = (p0[0] + p1[0]) / 2;
        var my = (p0[1] + p1[1]) / 2;
        var dx = p1[0] - p0[0];
        var dy = p1[1] - p0[1];
        var len = Math.sqrt(dx * dx + dy * dy) || 1;
        var nx = -dy / len;
        var ny = dx / len;
        var offset = (Math.random() * 2 - 1) * displace;
        var mid = [mx + nx * offset, my + ny * offset];
        midpointDisplace(p0, mid, displace * 0.55, depth - 1, out);
        midpointDisplace(mid, p1, displace * 0.55, depth - 1, out);
      }

      function generateBoltPath(x0, y0, x1, y1, displace, depth) {
        var points = [[x0, y0]];
        midpointDisplace([x0, y0], [x1, y1], displace, depth, points);
        return points;
      }

      function generateBranches(mainPoints) {
        var branches = [];
        var count = 1 + Math.floor(Math.random() * 3);
        for (var i = 0; i < count; i++) {
          var idx = Math.floor(mainPoints.length * (0.2 + Math.random() * 0.5));
          var start = mainPoints[idx];
          var length = 60 + Math.random() * 140;
          var angle = Math.PI / 2 + (Math.random() - 0.5) * 1.2; // mostly downward, spread sideways
          var end = [start[0] + Math.cos(angle) * length, start[1] + Math.sin(angle) * length];
          branches.push(generateBoltPath(start[0], start[1], end[0], end[1], length * 0.25, 3));
        }
        return branches;
      }

      function drawBoltPath(points, alpha, lineWidth, glow) {
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = '#eaf2ff';
        ctx.lineWidth = lineWidth;
        ctx.shadowColor = '#bcd7ff';
        ctx.shadowBlur = glow;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(points[0][0], points[0][1]);
        for (var i = 1; i < points.length; i++) ctx.lineTo(points[i][0], points[i][1]);
        ctx.stroke();
        ctx.restore();
      }

      function drawBolt(bolt, alpha) {
        drawBoltPath(bolt.main, alpha, 3, 25);
        for (var i = 0; i < bolt.branches.length; i++) {
          drawBoltPath(bolt.branches[i], alpha * 0.7, 1.6, 15);
        }
      }

      // Real lightning flickers — a bright instant strike, a brief dark gap,
      // a dimmer second flash, then the sky afterglow fades out. Returns
      // null once the sequence is over.
      function getLightningState(elapsedMs) {
        if (elapsedMs < 40) return { boltAlpha: 1, skyAlpha: 0.6 };
        if (elapsedMs < 90) return { boltAlpha: 0, skyAlpha: 0.1 };
        if (elapsedMs < 130) return { boltAlpha: 0.75, skyAlpha: 0.35 };
        if (elapsedMs < 300) return { boltAlpha: 0, skyAlpha: 0.16 * (1 - (elapsedMs - 130) / 170) };
        return null;
      }

      var activeBolt = null;
      var lightningTimeoutId = null;
      var lastLightningTime = -Infinity;

      function triggerLightning() {
        lastLightningTime = performance.now();

        var x0 = width * 0.15 + Math.random() * width * 0.7;
        var y0 = 0;
        var x1 = x0 + (Math.random() - 0.5) * width * 0.3;
        var y1 = height * (0.35 + Math.random() * 0.4);
        var mainPoints = generateBoltPath(x0, y0, x1, y1, Math.max(20, (y1 - y0) * 0.12), 6);

        activeBolt = {
          main: mainPoints,
          branches: generateBranches(mainPoints),
          startTime: lastLightningTime,
        };

        // The delay before thunder arrives IS how far away the strike was —
        // reuse it to shape how the thunder sounds too (closer = louder and
        // sharper, farther = quieter and duller), not just when it plays.
        // Captured here (not read from activeBolt later) because activeBolt
        // has already faded and cleared by the time this timeout fires.
        var thunderDelay = 250 + Math.random() * 1300;
        var distanceFactor = (thunderDelay - 250) / 1300;
        var pan = Math.max(-1, Math.min(1, (x0 / width) * 2 - 1));
        setTimeout(function () {
          playAccentSound(distanceFactor, pan);
        }, thunderDelay);

        clearTimeout(lightningTimeoutId);
        scheduleNextLightning();
      }

      function scheduleNextLightning() {
        var minDelay = 10000;
        var maxDelay = 120000;
        var next = minDelay + Math.random() * (maxDelay - minDelay);
        lightningTimeoutId = setTimeout(triggerLightning, next);
      }

      // ---- Animation loop ----
      var lastTime = null;
      var animationFrameId = null;
      function tick(timestamp) {
        if (lastTime === null) lastTime = timestamp;
        var dt = Math.min((timestamp - lastTime) / 1000, 0.05);
        lastTime = timestamp;

        ctx.clearRect(0, 0, width, height);
        ctx.lineCap = 'round';

        if (PARTICLE_TYPE === 'rain') {
          updateAndDrawRain(dt);
        } else if (PARTICLE_TYPE === 'snow') {
          updateAndDrawSnow(dt);
        } else if (PARTICLE_TYPE === 'wind') {
          updateAndDrawWind(dt);
        }

        if (activeBolt) {
          var state = getLightningState(timestamp - activeBolt.startTime);
          if (!state) {
            activeBolt = null;
            flashEl.style.opacity = 0;
          } else {
            flashEl.style.opacity = state.skyAlpha;
            if (state.boltAlpha > 0) drawBolt(activeBolt, state.boltAlpha);
          }
        }

        // Condensation on the glass, drawn last (nearest the viewer) and
        // deliberately soft-focus — close-up droplets on glass are far more
        // out of focus than whatever's happening outside.
        ctx.filter = 'blur(1.4px)';
        for (var c = 0; c < condensationDrops.length; c++) {
          var cd = condensationDrops[c];

          if (cd.sliding) {
            var slideSpeed = 26 + cd.r * 3;
            cd.y += slideSpeed * dt;
            cd.slideProgress += slideSpeed * dt;
            if (cd.slideProgress >= cd.slideDistance || cd.y > height) cd.sliding = false;
          } else if (Math.random() < 0.0006) {
            cd.sliding = true;
            cd.slideProgress = 0;
            cd.slideDistance = 40 + Math.random() * 120;
          }

          if (cd.y > height) {
            cd.y = -10;
            cd.x = Math.random() * width;
          }

          if (cd.sliding) {
            ctx.beginPath();
            ctx.moveTo(cd.x, cd.y - cd.slideProgress);
            ctx.lineTo(cd.x, cd.y);
            ctx.strokeStyle = 'rgba(200, 220, 255, 0.18)';
            ctx.lineWidth = cd.r * 0.6;
            ctx.stroke();
          }

          var grad = ctx.createRadialGradient(cd.x - cd.r * 0.3, cd.y - cd.r * 0.3, 0, cd.x, cd.y, cd.r);
          grad.addColorStop(0, 'rgba(255, 255, 255, 0.55)');
          grad.addColorStop(0.5, 'rgba(210, 225, 245, 0.28)');
          grad.addColorStop(1, 'rgba(210, 225, 245, 0)');
          ctx.beginPath();
          ctx.arc(cd.x, cd.y, cd.r, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
        }
        ctx.filter = 'none';

        animationFrameId = requestAnimationFrame(tick);
      }

      function startExperience() {
        startOverlay.style.display = 'none';
        timerSelect.style.display = 'inline-block';
        eyesButton.style.display = 'inline-block';

        audioCtx = new AudioCtx();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = 1;
        masterGain.connect(audioCtx.destination);

        if (ACCENT_URL) {
          loadSound(ACCENT_URL).then(function (buffer) {
            accentBuffer = buffer;
          });
        }

        if (LOOP_URL) {
          loadSound(LOOP_URL).then(startLoop);
        }

        applyIntensity();
        if (HAS_LIGHTNING) scheduleNextLightning();
        animationFrameId = requestAnimationFrame(tick);
      }

      startButton.addEventListener('click', function () {
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (!audioCtx) startExperience();
      });

      // ---- Closed-eyes mode ----
      // Hides all visuals behind an opaque overlay and stops the animation
      // loop entirely (particles/ripples/condensation/bolt drawing) — audio
      // keeps playing untouched, since the whole point is "eyes closed,
      // still listening". Lightning's own setTimeout chain doesn't depend
      // on the animation loop, so thunder still fires on schedule.
      var closedEyesActive = false;

      function enterClosedEyes() {
        closedEyesActive = true;
        closedEyesOverlay.classList.add('active');
        closedEyesHint.classList.remove('faded');
        // Force a reflow so the class removal above is committed before
        // re-adding it, otherwise the fade-out transition wouldn't replay
        // on a second entry.
        void closedEyesHint.offsetWidth;
        closedEyesHint.classList.add('faded');
        cancelAnimationFrame(animationFrameId);
      }

      function exitClosedEyes() {
        closedEyesActive = false;
        closedEyesOverlay.classList.remove('active');
        lastTime = null;
        animationFrameId = requestAnimationFrame(tick);
      }

      eyesButton.addEventListener('click', enterClosedEyes);

      // The overlay's own tap handles the exit; it also marks the click as
      // "handled" so the same tap doesn't bubble up and get treated as a
      // storm click (which would otherwise call down a stray lightning
      // strike the instant eyes re-open).
      closedEyesOverlay.addEventListener('click', function () {
        exitClosedEyes();
        suppressNextClick = true;
      });

      // ---- Sleep timer ----
      // There is no web API that can put a phone to sleep — the closest
      // thing (Wake Lock) only does the opposite, keeping the screen ON.
      // The honest equivalent is to stop everything and return to the very
      // first screen when the timer ends, same as a fresh reload — the
      // device can then dim/lock on its own once nothing is playing.
      var sleepTimerId = null;
      var sleepCountdownId = null;
      var sleepTimerEndsAt = null;

      function formatRemaining(ms) {
        var totalSeconds = Math.max(0, Math.ceil(ms / 1000));
        var minutes = Math.floor(totalSeconds / 60);
        var seconds = totalSeconds % 60;
        return minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
      }

      function updateTimerRemaining() {
        var remaining = sleepTimerEndsAt - Date.now();
        timerRemaining.textContent = formatRemaining(remaining);
        if (remaining <= 0) clearInterval(sleepCountdownId);
      }

      timerSelect.addEventListener('change', function () {
        clearTimeout(sleepTimerId);
        clearInterval(sleepCountdownId);

        var minutes = parseInt(timerSelect.value, 10);
        if (minutes > 0) {
          sleepTimerEndsAt = Date.now() + minutes * 60000;
          sleepTimerId = setTimeout(function () {
            location.reload();
          }, minutes * 60000);

          timerRemaining.style.display = 'inline';
          updateTimerRemaining();
          sleepCountdownId = setInterval(updateTimerRemaining, 1000);
        } else {
          timerRemaining.style.display = 'none';
        }
      });

      // ---- Slide up/down to make the storm wilder/calmer ----
      var dragState = null;
      var suppressNextClick = false;
      var gaugeHideTimeoutId = null;
      var DRAG_PIXELS_FOR_FULL_SWING = 260;

      document.addEventListener('pointerdown', function (e) {
        if (!audioCtx || closedEyesActive) return;
        if (e.target.closest && e.target.closest('button, select, a')) return;
        clearTimeout(gaugeHideTimeoutId);
        dragState = { startY: e.clientY, startIntensity: intensity, moved: 0 };
      });

      document.addEventListener('pointermove', function (e) {
        if (!dragState) return;
        var deltaY = dragState.startY - e.clientY;
        dragState.moved = Math.max(dragState.moved, Math.abs(deltaY));
        if (dragState.moved > 6) intensityGauge.classList.add('visible');
        setIntensity(dragState.startIntensity + deltaY / DRAG_PIXELS_FOR_FULL_SWING);
      });

      function endDrag() {
        if (!dragState) return;
        if (dragState.moved > 6) suppressNextClick = true;
        dragState = null;
        gaugeHideTimeoutId = setTimeout(function () { intensityGauge.classList.remove('visible'); }, 600);
      }
      document.addEventListener('pointerup', endDrag);
      document.addEventListener('pointercancel', endDrag);

      // Clicking the storm itself calls down a strike, for ambiances that
      // have one. Ignored on buttons/links, after a drag just happened,
      // and rate-limited so spam-clicking can't machine-gun overlapping
      // flashes and thunder.
      document.addEventListener('click', function (e) {
        if (suppressNextClick) {
          suppressNextClick = false;
          return;
        }
        if (!audioCtx || !HAS_LIGHTNING) return;
        if (e.target.closest && e.target.closest('button, select, a')) return;
        if (performance.now() - lastLightningTime < 700) return;
        triggerLightning();
      });
    })();
  </script>
</body>
</html>
