  <script>
    // Server-authoritative registry (src/routes/home/api-registry.js) — method,
    // path template and requiresJwt here must match what POST /dashboard/api-tester
    // will actually call, since the browser only ever sends an apiId, never a
    // raw path. Keeping one source of truth is what makes "try it" safe.
    const apiSpecs = <%- JSON.stringify(apiSpecs) %>;
    const JWT_STORAGE_KEY = 'lasTestJwt';

    let currentApiId = null;

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    // ── Response tree (same renderer used by the analytics event-metadata viewer) ──
    function renderJsonValue(value, keyLabel, depth) {
      depth = depth || 0;
      const isContainer = value !== null && typeof value === 'object';
      const keyHtml = keyLabel !== undefined
        ? `<span class="json-key">${escapeHtml(keyLabel)}</span><span class="json-punct">: </span>`
        : '';

      if (!isContainer) {
        const row = document.createElement('div');
        row.className = 'json-leaf-row';
        let valueHtml;
        if (typeof value === 'string') valueHtml = `<span class="json-string">"${escapeHtml(value)}"</span>`;
        else if (typeof value === 'number') valueHtml = `<span class="json-number">${value}</span>`;
        else if (typeof value === 'boolean') valueHtml = `<span class="json-boolean">${value}</span>`;
        else valueHtml = '<span class="json-null">null</span>';
        row.innerHTML = keyHtml + valueHtml;
        return row;
      }

      const isArray = Array.isArray(value);
      const entries = isArray ? value.map((v, i) => [i, v]) : Object.entries(value);

      const details = document.createElement('details');
      details.className = 'json-node';
      details.open = depth < 2;

      const summary = document.createElement('summary');
      const countLabel = `${entries.length} ${isArray ? 'item' : 'key'}${entries.length === 1 ? '' : 's'}`;
      summary.innerHTML = keyHtml +
        `<span class="json-punct">${isArray ? '[' : '{'}</span>` +
        `<span class="json-type-count">${countLabel}</span>` +
        `<span class="json-punct">${isArray ? ']' : '}'}</span>`;
      details.appendChild(summary);

      const nested = document.createElement('div');
      nested.className = 'json-node-nested';
      entries.forEach(([k, v]) => {
        nested.appendChild(renderJsonValue(v, k, depth + 1));
      });
      details.appendChild(nested);

      return details;
    }

    // ── "Try it" form ──────────────────────────────────────────────────────
    function fieldGroup(labelText, required, inputHtml, note) {
      return '<div class="api-field-group">' +
        `<label>${escapeHtml(labelText)}${required ? ' <span class="api-field-required">*</span>' : ''}</label>` +
        inputHtml +
        (note ? `<span class="api-field-note">${escapeHtml(note)}</span>` : '') +
        '</div>';
    }

    function buildPanel(spec) {
      const parts = [];

      parts.push(
        `<div class="api-endpoint"><span class="api-method api-method-${escapeHtml(spec.method)}">${escapeHtml(spec.method)}</span><code>${escapeHtml(spec.path)}</code></div>`
      );

      if (spec.description) {
        parts.push(`<p class="api-description">${escapeHtml(spec.description)}</p>`);
      }

      if (spec.requiresJwt) {
        parts.push(fieldGroup(
          'Authorization (JWT)',
          false,
          '<input type="text" class="api-input" data-field="jwt" placeholder="jwt obtenu via /v1/auth/login ou /v1/auth/register" />',
          'x-api-key est ajoutée automatiquement — seul le token joueur se colle ici.'
        ));
      }

      if (spec.params && spec.params.length) {
        parts.push(
          '<div class="api-info-section"><h4>Path params</h4>' +
          spec.params.map((p) => fieldGroup(
            p.name,
            true,
            `<input type="text" class="api-input" data-field="param:${escapeHtml(p.name)}" placeholder="${escapeHtml(p.note || '')}" />`,
            null
          )).join('') +
          '</div>'
        );
      }

      if (spec.query && spec.query.length) {
        parts.push(
          '<div class="api-info-section"><h4>Query params</h4>' +
          spec.query.map((q) => fieldGroup(
            q.name,
            /requis/i.test(q.note || ''),
            `<input type="text" class="api-input" data-field="query:${escapeHtml(q.name)}" placeholder="${escapeHtml(q.note || '')}" />`,
            null
          )).join('') +
          '</div>'
        );
      }

      if (spec.body !== undefined) {
        parts.push(
          '<div class="api-info-section"><h4>Body (JSON)</h4>' +
          '<textarea class="api-textarea" data-field="body" rows="9" spellcheck="false"></textarea></div>'
        );
        if (spec.bodyNote) {
          parts.push(`<div class="api-note">${escapeHtml(spec.bodyNote)}</div>`);
        }
      }

      parts.push(
        '<div class="api-send-row">' +
        '<button type="button" class="fi-btn fi-btn-create" id="api-send-btn">Envoyer la requête</button>' +
        '<span class="api-field-note">x-api-key ajoutée automatiquement par le serveur</span>' +
        '</div>'
      );

      parts.push('<div id="api-response" class="api-response" style="display:none"></div>');

      return parts.join('');
    }

    function openApiModal(apiId) {
      const spec = apiSpecs[apiId];
      if (!spec) return;
      currentApiId = apiId;

      document.getElementById('api-info-title').textContent = `${spec.method} ${spec.path}`;

      const bodyEl = document.getElementById('api-info-body');
      bodyEl.innerHTML = buildPanel(spec);

      // Set via the DOM property (not the HTML string) so example JSON never
      // has to survive an escape/unescape round-trip.
      const bodyField = bodyEl.querySelector('[data-field="body"]');
      if (bodyField && spec.body !== undefined) {
        bodyField.value = JSON.stringify(spec.body, null, 2);
      }

      const jwtField = bodyEl.querySelector('[data-field="jwt"]');
      if (jwtField) {
        jwtField.value = sessionStorage.getItem(JWT_STORAGE_KEY) || '';
      }

      document.getElementById('api-info-modal').style.display = 'flex';
    }

    function closeApiModal() {
      document.getElementById('api-info-modal').style.display = 'none';
      currentApiId = null;
    }

    // ── Firing the request through the server-side proxy ───────────────────
    async function sendApiRequest() {
      const spec = apiSpecs[currentApiId];
      if (!spec) return;

      const bodyEl = document.getElementById('api-info-body');
      const params = {};
      const query = {};
      let jwt;
      let bodyValue;
      let bodyParseError = null;

      bodyEl.querySelectorAll('[data-field]').forEach((el) => {
        const field = el.dataset.field;
        if (field === 'jwt') {
          jwt = el.value.trim() || undefined;
        } else if (field === 'body') {
          const raw = el.value.trim();
          if (raw) {
            try {
              bodyValue = JSON.parse(raw);
            } catch (e) {
              bodyParseError = `Body JSON invalide : ${e.message}`;
            }
          }
        } else if (field.startsWith('param:')) {
          params[field.slice(6)] = el.value.trim();
        } else if (field.startsWith('query:')) {
          const v = el.value.trim();
          if (v) query[field.slice(6)] = v;
        }
      });

      const responseEl = document.getElementById('api-response');
      responseEl.style.display = 'block';

      if (bodyParseError) {
        responseEl.innerHTML = `<div class="api-resp-status err">Erreur</div><p class="api-description">${escapeHtml(bodyParseError)}</p>`;
        return;
      }

      const sendBtn = document.getElementById('api-send-btn');
      sendBtn.disabled = true;
      sendBtn.textContent = 'Envoi…';
      responseEl.innerHTML = '<p class="api-description">Envoi en cours…</p>';

      try {
        const res = await fetch('/dashboard/api-tester', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ apiId: currentApiId, params, query, body: bodyValue, jwt }),
        });
        const data = await res.json();

        if (!data.success) {
          responseEl.innerHTML = `<div class="api-resp-status err">Erreur</div><p class="api-description">${escapeHtml(data.message || 'Requête échouée')}</p>`;
          return;
        }

        const status = data.response.status;
        const statusText = data.response.statusText;
        const respBody = data.response.body;
        const truncated = data.response.truncated;
        const statusClass = status < 300 ? 'ok' : status < 500 ? 'warn' : 'err';

        let capturedNote = '';
        if ((currentApiId === 'auth-login' || currentApiId === 'auth-register') && respBody && respBody.token) {
          sessionStorage.setItem(JWT_STORAGE_KEY, respBody.token);
          capturedNote = '<div class="api-note">JWT capturé — pré-rempli automatiquement pour les endpoints Cloud Saves.</div>';
        }

        responseEl.innerHTML =
          `<div class="api-resp-status ${statusClass}">${status} ${escapeHtml(statusText || '')}</div>` +
          capturedNote +
          '<div class="json-tree" id="api-response-tree"></div>' +
          (truncated ? '<div class="api-note">Réponse tronquée (trop volumineuse).</div>' : '');

        document.getElementById('api-response-tree').appendChild(renderJsonValue(respBody, undefined, 0));
      } catch (err) {
        responseEl.innerHTML = `<div class="api-resp-status err">Erreur</div><p class="api-description">${escapeHtml(err.message)}</p>`;
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Envoyer la requête';
      }
    }

    document.addEventListener('click', (e) => {
      if (e.target.id === 'api-send-btn') {
        sendApiRequest();
        return;
      }
      const card = e.target.closest('[data-api-id]');
      if (card) {
        openApiModal(card.dataset.apiId);
        return;
      }
      if (e.target.id === 'api-info-modal') closeApiModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeApiModal();
        return;
      }
      if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('[data-api-id]')) {
        e.preventDefault();
        openApiModal(e.target.dataset.apiId);
      }
    });

    document.getElementById('api-info-close').addEventListener('click', closeApiModal);
  </script>

