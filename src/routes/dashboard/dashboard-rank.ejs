<%- include('../partials/header') %>

  <main class="content">
    <section class="dashboard-header">
      <p class="section-label dashboard-kicker">Insights</p>
      <h1>Rank Submissions</h1>
      <p class="dashboard-sub">Labelled value submissions per user &mdash; filter by source, user, or a specific value</p>
      <div class="total"><%= total.toLocaleString('fr-FR') %> submission<%= total === 1 ? '' : 's' %></div>
    </section>

    <section class="analytics-toolbar">
      <form class="source-filter-form" method="get" action="/dashboard/rank">
        <div class="source-filter-grid">
          <div class="filter-field">
            <label for="f-source">Source</label>
            <select id="f-source" name="source" class="filter-input">
              <option value="">All sources</option>
              <% sources.forEach(s => { %>
                <option value="<%= s %>" <%= filters.source === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>

          <div class="filter-field">
            <label for="f-userId">User ID</label>
            <input type="text" id="f-userId" name="userId" class="filter-input" value="<%= filters.userId %>" placeholder="Any user" />
          </div>

          <div class="filter-field">
            <label for="f-value">Value</label>
            <input type="number" step="any" id="f-value" name="value" class="filter-input" value="<%= filters.value %>" placeholder="e.g. 42" />
          </div>

          <div class="filter-field filter-field-actions">
            <button type="submit" class="fi-btn fi-btn-create">Apply filters</button>
            <a href="/dashboard/rank" class="filter-clear">Clear</a>
          </div>
        </div>
      </form>
    </section>

    <% if (ranks.length === 0) { %>
      <div class="no-data">No rank submissions match these filters</div>
    <% } else { %>
      <div class="event-list">
        <div class="event-list-head" aria-hidden="true">
          <div>Date</div>
          <div>Source</div>
          <div>Version</div>
          <div>User ID</div>
          <div>Values</div>
        </div>

        <% ranks.forEach((r) => { %>
          <article class="event-card">
            <div class="event-card-row">
              <span class="event-field-label">Date</span>
              <span class="event-field-value timestamp"><%= new Date(r.createdAt).toLocaleString('fr-FR') %></span>
            </div>
            <div class="event-card-row">
              <span class="event-field-label">Source</span>
              <span class="event-field-value"><%= r.source || '—' %></span>
            </div>
            <div class="event-card-row">
              <span class="event-field-label">Version</span>
              <span class="event-field-value"><%= r.version || '—' %></span>
            </div>
            <div class="event-card-row">
              <span class="event-field-label">User ID</span>
              <span class="event-field-value"><%= r.userId || '—' %></span>
            </div>
            <% if (filters.value) { %>
              <div class="event-card-row">
                <span class="event-field-label">Matched label</span>
                <span class="event-field-value">
                  <% if (r.matchedLabel !== null) { %>
                    <span class="value-pair matched"><%= r.matchedLabel %>: <%= filters.value %></span>
                  <% } else { %>
                    &mdash;
                  <% } %>
                </span>
              </div>
            <% } %>
            <div class="event-card-row">
              <span class="event-field-label">Values</span>
              <span class="event-field-value value-pair-list">
                <% r.pairs.slice(0, 6).forEach((p) => { %>
                  <span class="value-pair <%= p.matched ? 'matched' : '' %>"><%= p.label %>: <%= p.value %></span>
                <% }) %>
                <% if (r.pairs.length > 6) { %>
                  <span class="value-pair-more">+<%= r.pairs.length - 6 %> more</span>
                <% } %>
              </span>
            </div>
            <div class="event-card-row">
              <span class="event-field-label"></span>
              <span class="event-field-value"><a href="/dashboard/rank/<%= r._id %>" class="stat-label-link">View details &rarr;</a></span>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (pages > 1) { %>
        <%
          const qs = (p) => {
            const params = new URLSearchParams();
            if (filters.source) params.set('source', filters.source);
            if (filters.userId) params.set('userId', filters.userId);
            if (filters.value) params.set('value', filters.value);
            params.set('page', p);
            return '?' + params.toString();
          };
        %>
        <nav class="pagination">
          <a class="page-link <%= page <= 1 ? 'disabled' : '' %>" href="<%= page <= 1 ? '#' : qs(page - 1) %>">&larr; Prev</a>
          <span class="page-info">Page <%= page %> / <%= pages %></span>
          <a class="page-link <%= page >= pages ? 'disabled' : '' %>" href="<%= page >= pages ? '#' : qs(page + 1) %>">Next &rarr;</a>
        </nav>
      <% } %>
    <% } %>
  </main>

<%- include('../partials/footer') %>
